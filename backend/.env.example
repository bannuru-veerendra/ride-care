# App (use production on Render so auth cookies are Secure + SameSite=None)
APP_ENV=development
JWT_SECRET_KEY=

# Single public frontend origin used in verification email links (not a CORS list)
FRONTEND_URL=http://localhost:5173

# Email. Prefer Brevo on Render (free tier blocks outbound SMTP ports).
# In Brevo: verify sender = your Gmail, then use that address in EMAIL_FROM.
EMAIL_FROM=RideCare <your-verified-gmail@gmail.com>
BREVO_API_KEY=
# Optional SMTP fallback for local / paid hosts (ignored when BREVO_API_KEY is set)
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Cron secret for POST /internal/reminder-digests (Render Cron → X-Cron-Secret header)
REMINDER_CRON_SECRET=

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase (File Storage)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ridecare-docs

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis (Upstash) - TCP connection
REDIS_URL=

# Environment (comma-separated; include every frontend origin that calls the API)
ALLOWED_ORIGINS=http://localhost:5173,https://ride-care-jade.vercel.app
